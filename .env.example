# Every environment variable the Ethics Sandbox reads. scripts/deploy.sh sets
# the first three itself; set one before running it to override.

# Signs the cookie that identifies a browser. Keep it secret and keep it the
# same between runs, or everyone loses their seat. deploy.sh makes one and
# keeps it in a file the first time. The development fallback is not secure.
SANDBOX_SECRET_KEY=

# Where tables are saved. SQLite file locally; a Postgres DSN in production,
# for example postgresql+psycopg://user:password@host/dbname.
DATABASE_URL=sqlite:///ethics-sandbox.db

# The address every invite link carries. deploy.sh sets it from the Mac's
# network address. Without it, links use the address the request arrived at.
SANDBOX_PUBLIC_URL=http://192.168.1.20:8000

# deploy.sh only: the port to serve on.
PORT=8000

# Tests and the Playwright server only: folders of extra game definitions,
# separated like PATH. Leave it unset in production.
# SANDBOX_EXTRA_GAMES=tests/games
